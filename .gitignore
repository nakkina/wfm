# Secrets and local settings
.env
config/wfm.yaml

# data/ (input workbooks) and runs/ (saved forecast and schedule runs) ARE committed, so a
# fresh clone shows forecasts and schedules without rerunning StatsForecast or CP-SAT.
# The data is synthetic (is_synthetic = True in both workbooks).

# Office lock files created while a workbook is open
~$*

# Python environment, build metadata and tool caches (recreated by `make install`)
backend/.venv/
__pycache__/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Frontend dependencies and build output (recreated by `make install` / `npm run build`)
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
